# Artefacts de debug et de travail
# Convention personnelle : traces, dumps et captures vivent sous /tmp, jamais
# dans le dépôt. Ces motifs ne sont qu'un filet de sécurité.
*.log
*.tmp
/tmp/

# Maquettes d'interface : artefacts de conception jetables, jamais versionnés.
docs/mockups/

# Secrets
.env
.env.*
!.env.example
secrets.env

# Éditeurs et systèmes
.vscode/
.idea/
*.swp
*~
.DS_Store

# Réglages Claude Code propres au poste
.claude/settings.local.json
CLAUDE.local.md

# Dépendances et artefacts de build
# Sans la barre oblique : un worktree de travail relie souvent son node_modules
# au checkout principal par un lien symbolique, et `node_modules/` ne l'attrape
# pas, un lien n'étant pas un répertoire pour git.
node_modules
dist/

# Sorties Playwright
test-results/
playwright-report/
# Captures et instantanés du navigateur piloté par MCP
.playwright-mcp/
